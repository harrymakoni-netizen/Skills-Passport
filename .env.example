# Skills Passport — environment variables. Copy to .env (`pnpm setup:env` generates fresh secrets).
# Every variable is validated at start-up by packages/config/src/env.ts.

NODE_ENV=development
LOG_LEVEL=info

# --- Data stores (docker compose up -d) -------------------------------------------------------------
DATABASE_URL=postgresql://sp:sp@localhost:5432/skills_passport
REDIS_URL=redis://localhost:6379

# --- URLs ----------------------------------------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
# Public URL of the web app: used in passport links, QR codes and client rating links.
PUBLIC_BASE_URL=http://localhost:3000
# How the web server reaches the API.
API_INTERNAL_URL=http://localhost:4000
# Base URL that serves the public media bucket (the web app proxies /media to the API locally; a CDN in production).
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

# --- Secrets (never commit real values) -------------------------------------------------------------
# 32 random bytes, base64. Encrypts names, phone numbers and other PII (AES-256-GCM).
PII_ENCRYPTION_KEY=
# Pepper for HMAC-SHA256 phone lookups. At least 32 characters.
PHONE_HASH_PEPPER=
# Signs staff session cookies and media URLs. At least 32 characters.
JWT_SECRET=

# --- Object storage ---------------------------------------------------------------------------------
# s3 = MinIO / any S3-compatible service (default). fs = local disk under STORAGE_FS_ROOT (no Docker needed).
# db = objects stored in PostgreSQL (serverless demo hosting, e.g. Vercel).
STORAGE_DRIVER=s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=sp-private
S3_BUCKET_PUBLIC=sp-public
S3_FORCE_PATH_STYLE=true

# --- WhatsApp ---------------------------------------------------------------------------------------
# mock = offline simulator at /dev/chat (default). whatsapp = Meta WhatsApp Cloud API.
# hybrid = Cloud API for real numbers; the fictional demo phones (+26377000xxxx) stay in the simulator.
MESSAGING_DRIVER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Business Account id: lets /admin/whatsapp show template approval status and submit templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# --- Speech to text ---------------------------------------------------------------------------------
# mock = fixture transcripts. whisper = any OpenAI-compatible /audio/transcriptions endpoint.
STT_DRIVER=mock
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# --- LLM --------------------------------------------------------------------------------------------
# mock = deterministic fixtures. anthropic = Anthropic Messages API (model name from LLM_MODEL).
LLM_DRIVER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=

# Enables /dev routes (WhatsApp simulator, design page) and mock-channel endpoints. Forced off in production
# unless PUBLIC_DEMO=true.
DEV_TOOLS=true

# --- Hosting ----------------------------------------------------------------------------------------
# server = api + worker processes with Redis (default). serverless = one Vercel deployment: the API runs inside the
# web app and the queue, key-value store and simulator chats live in PostgreSQL (see docs/DEPLOY.md).
RUNTIME=server
# Public demo build: keeps the WhatsApp simulator and demo sign-in help on in production. Fictional data only.
PUBLIC_DEMO=false
# Password for the seeded demo staff/buyer accounts; applied on every seed. Set it once real people's data is in.
STAFF_PASSWORD=
# Bearer token for the daily scheduled-task endpoint /api/cron/daily (serverless runtime).
CRON_SECRET=
