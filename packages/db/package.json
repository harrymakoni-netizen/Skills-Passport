{
  "name": "@sp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "demo:reset": "dotenv -e ../../.env -- tsx src/seed.ts --demo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@sp/adapters": "workspace:*",
    "@sp/config": "workspace:*",
    "@sp/core": "workspace:*",
    "zod": "^3.25.0",
    "ioredis": "^5.6.0",
    "bullmq": "^5.40.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "dotenv-cli": "^8.0.0",
    "@types/qrcode": "^1.5.5"
  }
}
